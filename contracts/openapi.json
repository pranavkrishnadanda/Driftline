{
  "components": {
    "schemas": {
      "AnswerSchema": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "answer_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Answer Id"
          },
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "cached": {
            "default": false,
            "title": "Cached",
            "type": "boolean"
          },
          "citations": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "claims": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "title": "Claims",
            "type": "array"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "cost_usd": {
            "default": 0.0,
            "title": "Cost Usd",
            "type": "number"
          },
          "degraded": {
            "default": false,
            "title": "Degraded",
            "type": "boolean"
          },
          "dropped_claims": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "title": "Dropped Claims",
            "type": "array"
          },
          "nearest_sources": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/NearestSource"
            },
            "title": "Nearest Sources",
            "type": "array"
          },
          "status": {
            "enum": [
              "answered",
              "insufficient_evidence",
              "refused"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "answer",
          "as_of",
          "confidence"
        ],
        "title": "AnswerSchema",
        "type": "object"
      },
      "AskAccepted": {
        "properties": {
          "events_url": {
            "title": "Events Url",
            "type": "string"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "status_url": {
            "title": "Status Url",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "events_url",
          "status_url"
        ],
        "title": "AskAccepted",
        "type": "object"
      },
      "AskEvent": {
        "discriminator": {
          "mapping": {
            "claim": "#/components/schemas/ClaimEvent",
            "error": "#/components/schemas/ErrorEvent",
            "final": "#/components/schemas/FinalEvent",
            "step": "#/components/schemas/StepEvent",
            "token": "#/components/schemas/TokenEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/StepEvent"
          },
          {
            "$ref": "#/components/schemas/TokenEvent"
          },
          {
            "$ref": "#/components/schemas/ClaimEvent"
          },
          {
            "$ref": "#/components/schemas/FinalEvent"
          },
          {
            "$ref": "#/components/schemas/ErrorEvent"
          }
        ]
      },
      "AskRequest": {
        "additionalProperties": false,
        "description": "Body of POST /v1/ask.",
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "source_kinds": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "openfda",
                    "git_docs",
                    "upload"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Kinds"
          },
          "tenant": {
            "minLength": 1,
            "title": "Tenant",
            "type": "string"
          }
        },
        "required": [
          "question",
          "tenant"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "Citation": {
        "description": "A cited chunk, with the metadata of the version it belongs to (for the UI).\n\nNew citations are built with `from_evidence`, which fills every metadata field.\nThe fields are optional only so answer bodies stored before they existed (in\n`answers.body` and the semantic cache) still load; the validator keeps them\nall-or-nothing, so a citation is either fully described or a legacy one.",
        "properties": {
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "document_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Document Id"
          },
          "external_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "External Id"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "section_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Section Path"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "valid_from": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Valid From"
          },
          "valid_to": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Valid To"
          },
          "version_id": {
            "format": "uuid",
            "title": "Version Id",
            "type": "string"
          },
          "version_no": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version No"
          }
        },
        "required": [
          "chunk_id",
          "version_id",
          "quote"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Claim": {
        "properties": {
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "idx": {
            "title": "Idx",
            "type": "integer"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "verified": {
            "default": false,
            "title": "Verified",
            "type": "boolean"
          }
        },
        "required": [
          "idx",
          "text",
          "citations"
        ],
        "title": "Claim",
        "type": "object"
      },
      "ClaimEvent": {
        "properties": {
          "citation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Citation"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "idx": {
            "title": "Idx",
            "type": "integer"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          },
          "type": {
            "const": "claim",
            "default": "claim",
            "title": "Type",
            "type": "string"
          },
          "verified": {
            "title": "Verified",
            "type": "boolean"
          }
        },
        "required": [
          "idx",
          "verified"
        ],
        "title": "ClaimEvent",
        "type": "object"
      },
      "ErrorEvent": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "default": "",
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "code",
          "retryable"
        ],
        "title": "ErrorEvent",
        "type": "object"
      },
      "FinalEvent": {
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/AnswerSchema"
          },
          "type": {
            "const": "final",
            "default": "final",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "title": "FinalEvent",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobStatus": {
        "properties": {
          "answer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnswerSchema"
              },
              {
                "type": "null"
              }
            ]
          },
          "cost_usd": {
            "default": 0.0,
            "title": "Cost Usd",
            "type": "number"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status"
        ],
        "title": "JobStatus",
        "type": "object"
      },
      "NearestSource": {
        "properties": {
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "external_id": {
            "title": "External Id",
            "type": "string"
          },
          "section_path": {
            "title": "Section Path",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "valid_from": {
            "format": "date-time",
            "title": "Valid From",
            "type": "string"
          },
          "valid_to": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Valid To"
          },
          "version_id": {
            "format": "uuid",
            "title": "Version Id",
            "type": "string"
          },
          "version_no": {
            "title": "Version No",
            "type": "integer"
          }
        },
        "required": [
          "document_id",
          "external_id",
          "title",
          "version_id",
          "version_no",
          "section_path",
          "valid_from"
        ],
        "title": "NearestSource",
        "type": "object"
      },
      "StepEvent": {
        "properties": {
          "detail": {
            "additionalProperties": true,
            "default": {},
            "title": "Detail",
            "type": "object"
          },
          "node": {
            "title": "Node",
            "type": "string"
          },
          "status": {
            "enum": [
              "started",
              "completed",
              "skipped",
              "retry",
              "hit",
              "miss",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "t_ms": {
            "default": 0.0,
            "title": "T Ms",
            "type": "number"
          },
          "type": {
            "const": "step",
            "default": "step",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "node",
          "status"
        ],
        "title": "StepEvent",
        "type": "object"
      },
      "TokenEvent": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "token",
            "default": "token",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "TokenEvent",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Driftline",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz"
      }
    },
    "/v1/ask": {
      "post": {
        "operationId": "ask_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "unknown tenant"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "backpressure"
          }
        },
        "summary": "Ask",
        "tags": [
          "ask"
        ]
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "operationId": "job_status_v1_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Job Status",
        "tags": [
          "ask"
        ]
      }
    },
    "/v1/jobs/{job_id}/events": {
      "get": {
        "operationId": "events_v1_jobs__job_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "last_event_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last Event Id"
            }
          },
          {
            "in": "header",
            "name": "last-event-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/AskEvent"
                }
              }
            },
            "description": "Server-sent events: `id: <n>`, `event: <type>`, `data: <JSON>`; `: ping` heartbeats; ends after `final` or a non-retryable `error`. Reconnect with Last-Event-ID to replay missed events."
          },
          "404": {
            "description": "unknown job"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "too many open streams"
          }
        },
        "summary": "Events",
        "tags": [
          "ask"
        ]
      }
    }
  }
}
