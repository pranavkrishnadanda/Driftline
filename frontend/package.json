{
  "name": "driftline-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "oxlint --deny-warnings",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ${DRIFTLINE_OPENAPI_URL:-http://localhost:8010/openapi.json} -o src/lib/api/schema.d.ts",
    "gen:api:file": "openapi-typescript ../contracts/openapi.json -o src/lib/api/schema.d.ts",
    "gen:sse": "bun scripts/gen-sse-types.mjs",
    "test:e2e:stub": "playwright test -c playwright.stub.config.ts",
    "test:e2e:demo": "playwright test -c playwright.demo.config.ts",
    "build:demo": "NEXT_PUBLIC_DRIFTLINE_DEMO=1 bun --bun next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-query": "5.104.5",
    "@visx/curve": "^4.0.0",
    "@visx/event": "^4.0.0",
    "@visx/gradient": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@xyflow/react": "12.12.0",
    "animejs": "4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "d3-array": "^3.2.4",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.89.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
