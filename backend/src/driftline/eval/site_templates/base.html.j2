<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }} · Driftline report</title>
<meta name="description" content="Driftline evaluation, benchmark and drift-watch results, generated from the committed report files.">
<link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="assets/style.css">
<script src="assets/site.js"></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="index.html" aria-label="Driftline report home">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="logo"><rect width="24" height="24" rx="7" class="logo-bg"/><path d="M5 15.5c2.5 0 3-4 5.5-4s3 3 5.5 3 2.5-5 3-6" fill="none" stroke-width="2" stroke-linecap="round" class="logo-fg-stroke"/><circle cx="19" cy="8.5" r="1.8" class="logo-fg"/></svg>
      <span>Driftline</span><span class="brand-sub">report</span>
    </a>
    <nav aria-label="Report pages">
      <ul class="nav">
      {% for p in PAGES %}
        <li><a href="{{ p.file }}"{% if p.file == page.file %} aria-current="page"{% endif %}>{{ p.title }}</a></li>
      {% endfor %}
        <li><a href="{{ DEMO_PATH }}">Live demo</a></li>
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    </button>
  </div>
</header>
<main id="main" class="wrap">
{% block main %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="wrap">
    <p>Every number on this site is read from report files committed in the
    <a href="{{ REPO_URL }}">Driftline repository</a> and rendered by
    <code>python -m driftline.eval site</code>{% if source_sha %} at commit <code>{{ source_sha[:12] }}</code>{% endif %}.
    Nothing is typed in by hand.</p>
  </div>
</footer>
</body>
</html>
