# Host port the gateway is published on (the container always listens on 8000).
DRIFTLINE_GATEWAY_PORT=8010
# Host port Postgres is published on (the container always listens on 5432).
# Defaults to 5433 because a native Postgres often holds 5432 on dev machines.
DRIFTLINE_POSTGRES_PORT=5433
# Host port the TEI embedder is published on (the container always listens on 80).
DRIFTLINE_EMBED_PORT=8080
# TEI image for the embedder. The default is the native arm64 tag
# (ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9.4).
# On amd64 hosts use the cpu-1.9.4 tag:
# DRIFTLINE_EMBED_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.4
# Host headers the MCP endpoint (/mcp) accepts, as a JSON list (`name:*` = any port);
# a request with any other Host gets 421. Add the name clients reach the gateway by:
# DRIFTLINE_MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","[::1]:*","gateway:*","driftline.example.com"]
