# Settings for the demo-capture stack (see compose.capture.yml). OFFLINE BY DEFAULT:
# no Claude key and DRIFTLINE_LLM_OFFLINE=true, so nothing here can spend money.
#
# A live capture with real Claude answers is an explicit opt-in, and it COSTS MONEY
# (the recorded demo's capture spent about $0.21 for 4 asks). To opt in, pass a later
# --env-file of your own (the last file wins) that sets DRIFTLINE_LLM_OFFLINE=false and
# DRIFTLINE_ANTHROPIC_API_KEY=<your key>, typed by hand. Never commit that file.

# Host ports of the demo-capture stack: none of them a dev stack's defaults.
DRIFTLINE_GATEWAY_PORT=18110
DRIFTLINE_POSTGRES_PORT=15433
DRIFTLINE_EMBED_PORT=18180
DRIFTLINE_RERANK_PORT=18181
DEMO_REDIS_PORT=16379
# No LLM: offline answers and drift checks, no key.
DRIFTLINE_LLM_OFFLINE=true
DRIFTLINE_ANTHROPIC_API_KEY=
DRIFTLINE_GEMINI_API_KEY=
# No tracing export from a throwaway stack.
DRIFTLINE_LANGFUSE_PUBLIC_KEY=
DRIFTLINE_LANGFUSE_SECRET_KEY=
